const nameInputs = Array.from(document.querySelectorAll('input[placeholder="Enter your full name"]'));
const visitorNames = [
   "Aarav Sharma",       // Visitor #1
    "Ananya Singh",       // Visitor #2
    "Rohan Patel",        // Visitor #3
    "Sneha Gupta",        // Visitor #4
    "Karan Mehta",        // Visitor #5
    "Priya Desai"         // Visitor #6
];
visitorNames.forEach((name, index) => {
    if (nameInputs[index]) {
        nameInputs[index].value = name;
        nameInputs[index].dispatchEvent(new Event("input", { bubbles: true }));
        nameInputs[index].dispatchEvent(new Event("change", { bubbles: true }));
        console.log(`✅ Visitor ${index + 1} name set to: ${name}`);
    } else {
        console.warn(`⚠️ No input field found for Visitor ${index + 1}`);
    }
});




