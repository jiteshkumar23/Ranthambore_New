    "code": "const nameInputs = Array.from(document.querySelectorAll('input[placeholder=\"Enter your full name\"]'));\nconst visitorNames = [\n   \"Aarav Sharma\",       // Visitor #1\n    \"Ananya Singh\",       // Visitor #2\n    \"Rohan Patel\",        // Visitor #3\n    \"Sneha Gupta\",        // Visitor #4\n    \"Karan Mehta\",        // Visitor #5\n    \"Priya Desai\"         // Visitor #6\n];\nvisitorNames.forEach((name, index) => {\n    if (nameInputs[index]) {\n        nameInputs[index].value = name;\n        nameInputs[index].dispatchEvent(new Event(\"input\", { bubbles: true }));\n        nameInputs[index].dispatchEvent(new Event(\"change\", { bubbles: true }));\n        console.log(`Visitor ${index + 1} name set to: ${name}`);\n    } else {\n        console.warn(`No input field found for Visitor ${index + 1}`);\n    }\n});\n\nconst genderSelects = Array.from(document.querySelectorAll('select[placeholder=\"Select Gender\"][name^=\"data\"][name*=\"[gender]\"]'));\nconst genderValues = [\n  'male',    // Visitor #1\n  'male',  // Visitor #2\n  'male',   // Visitor #3\n  'male',    // Visitor #4\n  'female',  // Visitor #5\n  'female'    // Visitor #6\n];\n\ngenderValues.forEach((gender, index) => {\n  const selectEl = genderSelects[index];\n  if (selectEl) {\n    selectEl.value = gender;\n    selectEl.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    console.log(`Visitor ${index + 1} gender set to: ${gender}`);\n  } else {\n    console.warn(`No gender dropdown found for Visitor ${index + 1}`);\n  }\n});\n\nconst touristTypeDropdowns = Array.from(document.querySelectorAll(\n  'select[placeholder=\"Select Tourist Type\"][name^=\"data\"][name*=\"[touristType]\"]'\n));\n\nconst touristTypes = [\n  'indian',      // Visitor #1\n  'foreigner',   // Visitor #2\n  'indian',      // Visitor #3\n  'foreigner',   // Visitor #4\n  'indian',      // Visitor #5\n  'foreigner'    // Visitor #6\n];\n\ntouristTypes.forEach((type, index) => {\n  const selectEl = touristTypeDropdowns[index];\n  if (selectEl) {\n    selectEl.value = type;\n    selectEl.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    console.log(`Visitor ${index + 1} tourist type set to: ${type}`);\n  } else {\n    console.warn(`No tourist type dropdown found for Visitor ${index + 1}`);\n  }\n});\n\nconst idTypeDropdowns = Array.from(document.querySelectorAll(\n  'select[placeholder=\"Select ID type\"][name^=\"data\"][name*=\"[idType]\"]'\n));\n\nconst idTypes = [\n  'indianVoterCard',  // Visitor #1\n  'passport',        // Visitor #2\n  'panCard',         // Visitor #3\n  'passport', // Visitor #4\n  'aadhar',          // Visitor #5\n  'passport'         // Visitor #6\n];\n\nidTypes.forEach((idType, index) => {\n  const selectEl = idTypeDropdowns[index];\n  if (selectEl) {\n    selectEl.value = idType;\n    selectEl.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    console.log(`Visitor ${index + 1} ID type set to: ${idType}`);\n  } else {\n    console.warn(`No ID type dropdown found for Visitor ${index + 1}`);\n  }\n});\n\nconst idProofInputs = Array.from(document.querySelectorAll(\n  'input[placeholder=\"ID Proof value\"][name^=\"data\"][name*=\"[idValue]\"]'\n));\n\nconst idProofValues = [\n  'HVV1234567',     // Visitor #1\n  'M1234567',           // Visitor #2\n  'ABCDE1234F',         // Visitor #3\n  'XYZ1234567',         // Visitor #4\n  '789043215678',     // Visitor #5\n  'N9876543'            // Visitor #6\n];\n\nidProofValues.forEach((value, index) => {\n  const inputEl = idProofInputs[index];\n  if (inputEl) {\n    inputEl.value = value;\n    inputEl.dispatchEvent(new Event(\"input\", { bubbles: true }));\n    inputEl.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    console.log(`Visitor ${index + 1} ID proof value set to: ${value}`);\n  } else {\n    console.warn(`No input field found for Visitor ${index + 1}`);\n  }\n});\n\n\nconst ageInputs = Array.from(document.querySelectorAll(\n  'input[placeholder=\"Age of the visitor\"][name^=\"data\"][name*=\"[age]\"]'\n));\n\nconst visitorAges = [\n  '34', // Visitor #1\n  '29', // Visitor #2\n  '41', // Visitor #3\n  '22', // Visitor #4\n  '37', // Visitor #5\n  '48'  // Visitor #6\n];\n\nvisitorAges.forEach((age, index) => {\n  const inputEl = ageInputs[index];\n  if (inputEl) {\n    inputEl.value = age;\n    inputEl.dispatchEvent(new Event(\"input\", { bubbles: true }));\n    inputEl.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    console.log(`Visitor ${index + 1} age set to: ${age}`);\n  } else {\n    console.warn(`No age input found for Visitor ${index + 1}`);\n  }\n});\n",
